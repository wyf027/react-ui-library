{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@wuyangfan/nova-ui": [
        "../packages/ui/src/index.ts"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ]
    },
    "types": [
      "node",
      "react",
      "react-dom"
    ]
  },
  "include": [
    ".dumirc.ts",
    ".dumi/plugins/**/*.ts",
    ".dumi/theme/**/*.tsx",
    "demos/**/*.tsx"
  ]
}
